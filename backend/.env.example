# Firebase Admin SDK credentials (server).
# Generate it from your serviceAccountKey.json with:
#     jq -c . serviceAccountKey.json
# then paste the output (a single { ... } line) as the value below.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Public Firebase web config (exposed to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated bootstrap admins. Everyone else is a normal user until an
# admin adds them from /admin/events.
ADMIN_EMAILS=you@example.com
